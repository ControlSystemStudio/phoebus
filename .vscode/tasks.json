{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Phoebus product",
            "type": "process",
            "command": "mvn",
            "args": [
                "-DskipTests",
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Clean build Phoebus product",
            "type": "process",
            "command": "mvn",
            "args": [
                "-DskipTests",
                "clean",
                "install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
